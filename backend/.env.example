# The canonical environment file is the ROOT .env (template: ../.env.example).
# The backend loads ../.env relative to its working directory, so start it
# from the backend/ directory (e.g. `cd backend && go run ./cmd/api`).
# Set ENV_FILE in the process environment to read a different file instead.
# No env file is read when APP_ENV=production.
# Process environment variables take precedence over values in the file.
# This file only documents the keys the backend reads.

POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_PORT=5432

DB_HOST=127.0.0.1
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_STATEMENT_TIMEOUT=30s

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=10s

# Empty disables CORS; e.g. http://localhost:3000 for direct browser calls.
CORS_ALLOWED_ORIGINS=
# Empty trusts no proxy; e.g. 10.0.0.0/8 for a private load balancer.
TRUSTED_PROXIES=
