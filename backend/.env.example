# The canonical environment file is the ROOT .env (template: ../.env.example).
# The backend loads ../.env relative to its working directory, so start it
# from the backend/ directory (e.g. `cd backend && go run .`).
# Process environment variables take precedence over values in ../.env.
# This file only documents the keys the backend reads.

POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_PORT=5432

DB_HOST=127.0.0.1
DB_SSLMODE=disable

APP_ENV=development
APP_PORT=8080
