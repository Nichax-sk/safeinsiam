# Root environment template for SafeInSiam.
# Copy to .env (never commit .env). The root .env is the single source of
# truth for both Docker Compose and the Go backend.

# PostgreSQL (used by docker-compose.yml and backend/internal/config)
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_PORT=5432

# Backend database connection
DB_HOST=127.0.0.1
DB_SSLMODE=disable

# Backend application
APP_ENV=development
APP_PORT=8080
