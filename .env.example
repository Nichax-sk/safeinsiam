# Root environment template for SafeInSiam.
# Copy to .env (never commit .env). The root .env is the single source of
# truth for both Docker Compose and the Go backend.
#
# The backend reads ../.env relative to its working directory (start it from
# backend/). Set ENV_FILE in the process environment to read a different file.
# No env file is read when APP_ENV=production.

# PostgreSQL (used by docker-compose.yml and backend/internal/config)
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_PORT=5432

# Backend database connection
DB_HOST=127.0.0.1
# disable | allow | prefer | require | verify-ca | verify-full
# (production requires require, verify-ca or verify-full)
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
# Go duration; 0 disables the server-side statement timeout
DB_STATEMENT_TIMEOUT=30s

# Backend application
# development | test | staging | production
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
# debug | info | warn | error (default: debug in development, info otherwise)
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=10s
